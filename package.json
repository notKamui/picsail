{
  "name": "picsail",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "preview": "vp preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "auth:secret": "vpx @better-auth/cli@latest secret",
    "auth:generate": "vpx @better-auth/cli@latest generate --y --output ./src/server/db/schema/auth.ts && vp check --fix",
    "auth:admin:create": "vpx auth@latest create-admin",
    "dev:docker": "docker compose -f docker-compose.dev.yml",
    "dev:docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "prepare": "vp config"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-query-devtools": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "taze": "^21.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
